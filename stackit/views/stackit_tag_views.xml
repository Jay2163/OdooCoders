<odoo>
    <!--stock question tree view-->
    <record id="stackit_tag_view_list" model="ir.ui.view">
            <field name="name">stockit.tag.list.view</field>
            <field name="model">stackit.tag</field>
            <field name="arch" type="xml">
                <list string="Tags">
                    <field name="name"/>
                </list>
            </field>
    </record>

    <!--book form view-->
    <record id="stackit_tag_view_form" model="ir.ui.view">
            <field name="name">stockit.tag.form.view</field>
            <field name="model">stackit.tag</field>
            <field name="arch" type="xml">
                <form string="Tags">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

    <record id="action_stackit_tag" model="ir.actions.act_window">
       <field name="name">Tag</field>
       <field name="res_model">stackit.tag</field>
       <field name="view_mode">list,form</field>
       <field name="view_id" ref="stackit_tag_view_list"/>
       <field name="help" type="html">
           <p class="o_view_nocontent_smiling_face">
               Generate stackit Details
           </p>
       </field>
    </record>

    <menuitem id="stackit_tag_menu" name="Stackit Tag" parent="menu_stackit" action="action_stackit_tag"
              sequence="15"/>
</odoo>

