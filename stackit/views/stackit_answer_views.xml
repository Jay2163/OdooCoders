<odoo>
    <!--stock question tree view-->
    <record id="stackit_answer_view_list" model="ir.ui.view">
            <field name="name">stockit.answer.list.view</field>
            <field name="model">stackit.answer</field>
            <field name="arch" type="xml">
                <list string="Answers">
                    <field name="answer"/>
                    <field name="user_id"/>
                </list>
            </field>
    </record>

    <!--book form view-->
    <record id="stackit_answer_view_form" model="ir.ui.view">
            <field name="name">stockit.answer.form.view</field>
            <field name="model">stackit.answer</field>
            <field name="arch" type="xml">
                <form string="Questions">
                    <sheet>
                        <group>
                            <group>
                                <field name="answer"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

    <record id="action_stackit_answer" model="ir.actions.act_window">
       <field name="name">Answer</field>
       <field name="res_model">stackit.answer</field>
       <field name="view_mode">list,form</field>
       <field name="view_id" ref="stackit_answer_view_list"/>
       <field name="help" type="html">
           <p class="o_view_nocontent_smiling_face">
               Generate stackit Details
           </p>
       </field>
    </record>

    <menuitem id="stackit_answer_menu" name="Answer" parent="stackit_main_menu" action="action_stackit_answer"
              sequence="15"/>
</odoo>

